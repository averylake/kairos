/* ─────────────────────────────────────────
   Kairos — Avery Lake, 2026
   kairos.averylakeofficial.com
───────────────────────────────────────── */

*, *::before, *::after {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

:root {
  --bg:         #0a0806;
  --warm:       #e8c87a;
  --warm-mid:   #c8a96e;
  --warm-dim:   rgba(232, 200, 122, 0.13);
  --warm-glow:  rgba(232, 200, 122, 0.28);
  --text:       #f0e8d8;
  --text-dim:   rgba(240, 232, 216, 0.42);
  --border:     rgba(232, 200, 122, 0.14);
}

html, body {
  width: 100%;
  height: 100%;
  overflow: hidden;
  background: var(--bg);
  color: var(--text);
  font-family: 'Lora', Georgia, serif;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

/* ── Topbar ──────────────────────────────── */

.topbar {
  position: fixed;
  top: 0; left: 0; right: 0;
  height: 52px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 24px;
  z-index: 200;
}

.brand-button {
  background: none;
  border: none;
  color: var(--warm);
  font-family: 'Lora', Georgia, serif;
  font-size: 11px;
  letter-spacing: 5px;
  text-transform: uppercase;
  cursor: pointer;
  opacity: 0.6;
  transition: opacity 0.3s;
  padding: 0;
}
.brand-button:hover { opacity: 1; }

/* ── Sound toggle ────────────────────────── */

.sound-toggle {
  background: none;
  border: none;
  cursor: pointer;
  padding: 4px;
  display: flex;
  align-items: center;
  opacity: 0.55;
  transition: opacity 0.3s;
}
.sound-toggle:hover { opacity: 1; }

.sound-toggle__track {
  width: 32px;
  height: 18px;
  border-radius: 9px;
  border: 1px solid var(--warm);
  position: relative;
  display: block;
  transition: border-color 0.3s;
}

.sound-toggle__thumb {
  width: 12px;
  height: 12px;
  border-radius: 50%;
  background: var(--warm);
  position: absolute;
  top: 2px;
  left: 2px;
  transition: transform 0.3s, background 0.3s;
}

.sound-toggle[aria-pressed="true"] .sound-toggle__thumb {
  transform: translateX(14px);
}
.sound-toggle[aria-pressed="false"] .sound-toggle__track {
  border-color: var(--text-dim);
}
.sound-toggle[aria-pressed="false"] .sound-toggle__thumb {
  background: var(--text-dim);
  transform: translateX(0);
}

/* ── Fog / ambient particles ─────────────── */

.fog-container {
  position: fixed;
  inset: 0;
  pointer-events: none;
  z-index: 1;
}

.mote {
  position: absolute;
  border-radius: 50%;
  background: var(--warm);
  opacity: 0;
  animation: mote-drift linear infinite;
}

@keyframes mote-drift {
  0%   { opacity: 0;    transform: translate(0, 0) scale(1); }
  15%  { opacity: 0.30; }
  85%  { opacity: 0.10; }
  100% { opacity: 0;    transform: translate(var(--mx), var(--my)) scale(0.4); }
}

/* ── Warmth bloom ────────────────────────── */

.warmth-bloom {
  position: fixed;
  inset: 0;
  background: radial-gradient(
    ellipse at center,
    rgba(232, 200, 122, 0.16) 0%,
    rgba(232, 200, 122, 0.05) 42%,
    transparent 68%
  );
  pointer-events: none;
  opacity: 0;
  z-index: 2;
  transition: opacity 2.4s ease;
}
.warmth-bloom.active { opacity: 1; }

/* ── Letters stage ───────────────────────── */

.letters-stage {
  position: fixed;
  inset: 0;
  z-index: 10;
}

/* ── Individual letters ──────────────────── */
/*
  Letters are rendered as background-images using extracted
  PNGs from Indiana's public-domain LOVE composition.
  Size is set via JS (getLetterSize). CSS handles glow via filter.
*/

.letter {
  position: absolute;
  cursor: pointer;
  user-select: none;
  -webkit-user-select: none;
  will-change: left, top, transform, opacity;
  background-size: contain;
  background-repeat: no-repeat;
  background-position: center;
  /* Soft ambient glow */
  filter: drop-shadow(0 0 14px rgba(232, 200, 122, 0.38));
  transition: opacity 2.2s ease, filter 2.2s ease;
}

/*
  Text fallback — shown when letter PNGs haven't been generated yet.
  Once assets/letter-X.png exist the img element takes over; this class
  is only added by JS on image onerror.
*/
.letter--text {
  font-family: 'Bodoni Moda', Georgia, serif;
  font-weight: 900;
  font-size: clamp(72px, 13vmin, 148px);
  color: var(--warm);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: visible;
}

/* Floating drift animation */
.letter.floating {
  animation: letter-drift var(--dur, 13s) ease-in-out infinite alternate;
}

.letter.floating:hover {
  filter:
    drop-shadow(0 0 22px rgba(232, 200, 122, 0.80))
    brightness(1.10);
}

@keyframes letter-drift {
  from { transform: translate(0, 0); }
  to   { transform: translate(var(--dx, 0rem), var(--dy, 0rem)); }
}

/*
  Traveling to placed position — soft dreamy drift.
*/
.letter.placing {
  cursor: default;
  transition:
    left      2.6s cubic-bezier(0.08, 0.52, 0.26, 1),
    top       2.6s cubic-bezier(0.08, 0.52, 0.26, 1),
    transform 2.6s cubic-bezier(0.08, 0.52, 0.26, 1),
    filter    0.8s ease,
    opacity   2.2s ease;
}

/* Placed upright — O after first click, invites second */
.letter.placed-upright {
  cursor: pointer;
  pointer-events: all;
  animation: placed-breathe-upright 2.8s ease-in-out infinite;
  transition: opacity 2.2s ease, filter 2.2s ease;
}

@keyframes placed-breathe-upright {
  0%, 100% {
    filter: drop-shadow(0 0 18px rgba(232, 200, 122, 0.55));
  }
  50% {
    filter:
      drop-shadow(0 0 32px rgba(232, 200, 122, 0.90))
      brightness(1.06);
  }
}

/* Fully settled */
.letter.placed {
  cursor: default;
  pointer-events: none;
  animation: placed-breathe 3.5s ease-in-out infinite;
  transition: opacity 2.2s ease, filter 2.2s ease;
}

@keyframes placed-breathe {
  0%, 100% {
    filter: drop-shadow(0 0 20px rgba(232, 200, 122, 0.60));
  }
  50% {
    filter:
      drop-shadow(0 0 38px rgba(232, 200, 122, 1.00))
      brightness(1.08)
      drop-shadow(0 0 8px rgba(255, 255, 255, 0.08));
  }
}

/* ── Revelation ──────────────────────────── */

.revelation {
  position: fixed;
  inset: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  z-index: 50;
  pointer-events: none;
  gap: 0.3em;
  padding: 0 24px;
}

.revelation-line {
  font-family: 'Lora', Georgia, serif;
  font-size: clamp(26px, 4.8vw, 58px);
  font-weight: 400;
  font-style: italic;
  color: var(--text);
  letter-spacing: 0.02em;
  text-align: center;
  opacity: 0;
  transform: translateY(14px);
  transition: opacity 1.5s ease, transform 1.5s ease;
}

.revelation-line.visible {
  opacity: 1;
  transform: translateY(0);
}

/* "Remember?" — distinct, warm, smaller */
#r-line-0 {
  font-family: 'Lora', Georgia, serif;
  font-size: clamp(20px, 3.4vw, 40px);
  font-style: italic;
  letter-spacing: 0.08em;
  color: var(--warm);
  margin-bottom: 0.55em;
}

/* ── Artifact prompt ─────────────────────── */

.artifact-prompt {
  position: fixed;
  bottom: 60px;
  left: 50%;
  transform: translateX(-50%);
  z-index: 60;
  opacity: 0;
  transition: opacity 1.2s ease;
  pointer-events: none;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12px;
  width: min(460px, 90vw);
}
.artifact-prompt.visible {
  opacity: 1;
  pointer-events: all;
}

.artifact-btn {
  background: transparent;
  border: 1px solid var(--border);
  color: var(--text);
  font-family: 'Lora', Georgia, serif;
  font-size: 11px;
  font-weight: 400;
  letter-spacing: 3px;
  text-transform: uppercase;
  padding: 10px 28px;
  border-radius: 20px;
  cursor: pointer;
  white-space: nowrap;
  transition: border-color 0.3s, color 0.3s, background 0.3s;
}
.artifact-btn:hover {
  border-color: var(--warm);
  color: var(--warm);
  background: var(--warm-dim);
}

.artifact-note {
  font-family: 'Lora', Georgia, serif;
  font-size: 11px;
  letter-spacing: 0.5px;
  color: var(--text-dim);
  font-style: italic;
}

.artifact-link {
  color: var(--warm);
  text-decoration: none;
  opacity: 0.8;
  transition: opacity 0.2s;
}
.artifact-link:hover { opacity: 1; }

.artist-statement {
  font-family: 'Lora', Georgia, serif;
  font-size: 13px;
  font-style: italic;
  line-height: 1.85;
  color: var(--text-dim);
  text-align: center;
  max-width: 380px;
  margin-top: 8px;
}

/* ── Footer ──────────────────────────────── */

.footer {
  position: fixed;
  bottom: 0; left: 0; right: 0;
  height: 40px;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
}

.footer-link {
  font-family: 'Lora', Georgia, serif;
  font-size: 10px;
  letter-spacing: 3px;
  text-transform: uppercase;
  color: var(--text-dim);
  text-decoration: none;
  opacity: 0.6;
  transition: opacity 0.3s, color 0.3s;
}
.footer-link:hover {
  opacity: 1;
  color: var(--warm);
}

/* ── In-app browser notice ───────────────── */

.inapp-notice {
  position: fixed;
  inset: 0;
  background: var(--bg);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 40px 32px;
  text-align: center;
  z-index: 999;
  gap: 20px;
}

.inapp-notice h2 {
  font-family: 'Lora', Georgia, serif;
  font-size: clamp(22px, 5vw, 34px);
  font-style: italic;
  font-weight: 400;
  color: var(--warm);
}

.inapp-notice p {
  font-family: 'Lora', Georgia, serif;
  font-size: 14px;
  line-height: 1.75;
  color: var(--text-dim);
  max-width: 300px;
}

.inapp-url {
  font-family: 'Courier New', monospace;
  font-size: 12px;
  color: var(--warm);
  background: var(--warm-dim);
  padding: 8px 16px;
  border-radius: 4px;
  cursor: pointer;
  word-break: break-all;
  transition: background 0.2s;
}
.inapp-url:hover { background: rgba(232, 200, 122, 0.22); }

/* ── Utility ─────────────────────────────── */

.sr-only {
  position: absolute;
  width: 1px; height: 1px;
  padding: 0; margin: -1px;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
  border: 0;
}
